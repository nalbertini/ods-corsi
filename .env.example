# Copiare in `.env` per far parlare l'app con un database vero. Senza queste
# due righe l'app parte in modalità prova, con dati inventati: vedi
# supabase/LEGGIMI.md.
#
# La chiave anon è pubblica di proposito e finisce nel bundle. A proteggere i
# dati sono le policy RLS, non questa stringa.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Facoltativa: i suggerimenti di indirizzo nelle gare (Google Places API New,
# a pagamento). Finisce nel bundle: in Google Cloud va limitata al dominio
# dell'app e alla sola Places API. Senza, l'indirizzo è testo libero.
VITE_GOOGLE_PLACES_KEY=
