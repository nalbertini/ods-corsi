{
  "permissions": {
    "allow": [
      "mcp__Supabase",
      "Bash(gh pr merge *)"
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "transcripted-live@transcripted": false,
    "mission-control@claude-code-mods": false,
    "cc-plugin-you-should-know@builtin": false,
    "data@synced": false,
    "design@synced": false,
    "legal@synced": false,
    "lseg@synced": false,
    "financial-analysis@synced": false,
    "wealth-management@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "pdf-viewer@synced": false,
    "desktop-commander@synced": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protegge.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicola/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicola/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/tipi.mjs\"",
            "timeout": 120,
            "statusMessage": "Controllo dei tipi…"
          }
        ]
      }
    ]
  }
}
