      "html": "<div class=\"ds-rule\"><span class=\"ds-rule-label\">ISCRITTI</span><span class=\"ds-rule-line\"></span><span class=\"ds-rule-conto\">22</span></div>",
      "css": ".ds-rule{display:flex;align-items:baseline;gap:10px;padding:22px 0 10px;font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif}.ds-rule-label{font-size:15px;font-weight:700;letter-spacing:.24em;color:#8c8c88}.ds-rule-line{flex-grow:1;height:2px;background:#2a2a2a}.ds-rule-conto{font-size:15px;font-weight:600;color:#8c8c88;font-variant-numeric:tabular-nums}"
