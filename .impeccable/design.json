  "components": [
    {
      "name": "Tasto Primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "L'azione principale: rosso, maiuscolo, obliquo.",
      "html": "<button class=\"ds-btn ds-btn-primary\">AVVIA IL TIMER</button>",
      "css": ".ds-btn{min-height:56px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif;font-style:oblique 9deg;font-size:19px;font-weight:700;letter-spacing:.16em;border:none;border-radius:0;cursor:pointer;transition:border-color 120ms,color 120ms}.ds-btn-primary{background:#e4292a;color:#ffffff}.ds-btn-primary:focus-visible{outline:2px solid #f2f2f0;outline-offset:2px}.ds-btn-primary:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "Tasto Vai",
      "kind": "button",
      "refersTo": "button-go",
      "description": "Conferma: presenza segnata, invio.",
      "html": "<button class=\"ds-btn-go\">TUTTI PRESENTI</button>",
      "css": ".ds-btn-go{min-height:56px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif;font-style:oblique 9deg;font-size:19px;font-weight:700;letter-spacing:.16em;border:none;border-radius:0;background:#16a54a;color:#121212;cursor:pointer}.ds-btn-go:focus-visible{outline:2px solid #f2f2f0;outline-offset:2px}"
    },
    {
      "name": "Tasto a Linea",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Azione secondaria: bordo 2px che si accende al passaggio.",
      "html": "<button class=\"ds-btn-ghost\">ANNULLA</button>",
      "css": ".ds-btn-ghost{min-height:56px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif;font-style:oblique 9deg;font-size:19px;font-weight:700;letter-spacing:.16em;background:none;border:2px solid #333333;border-radius:0;color:#b8b8b2;cursor:pointer;transition:border-color 120ms,color 120ms}.ds-btn-ghost:hover{border-color:#8c8c88;color:#f2f2f0}.ds-btn-ghost:focus-visible{outline:2px solid #f2f2f0;outline-offset:2px}"
    },
    {
      "name": "Campo",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo squadrato; il fuoco accende il bordo.",
      "html": "<input class=\"ds-campo\" placeholder=\"Email\" />",
      "css": ".ds-campo{min-height:52px;padding:0 14px;font-family:Barlow,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:17px;background:#1c1c1c;border:2px solid #333333;border-radius:0;color:#f2f2f0}.ds-campo::placeholder{color:#5a5a56}.ds-campo:focus{outline:none;border-color:#f2f2f0}"
    },
    {
      "name": "Schede",
      "kind": "nav",
      "refersTo": "scheda",
      "description": "Le schede sotto la testata: tasti uguali, l'attiva col bordo acceso.",
      "html": "<div class=\"ds-schede\"><button class=\"ds-scheda\" data-on=\"true\">CALENDARIO</button><button class=\"ds-scheda\">I MIEI TIMER</button></div>",
      "css": ".ds-schede{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:4px}.ds-scheda{min-height:40px;padding:0 18px;background:#1c1c1c;border:2px solid #333333;border-radius:0;font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif;font-size:14px;font-weight:700;letter-spacing:.18em;color:#8c8c88;cursor:pointer}.ds-scheda:hover{color:#f2f2f0}.ds-scheda[data-on=true]{background:#242424;border-color:#f2f2f0;color:#f2f2f0}.ds-scheda:focus-visible{outline:2px solid #f2f2f0;outline-offset:2px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Filtro della segreteria; premuto si accende.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">OGGI</button> <button class=\"ds-chip\" aria-pressed=\"false\">SETTIMANA</button>",
      "css": ".ds-chip{min-height:40px;padding:0 12px;background:none;border:2px solid #333333;border-radius:0;color:#c9c9c4;font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif;font-size:13px;font-weight:700;letter-spacing:.12em;white-space:nowrap;cursor:pointer}.ds-chip:hover{color:#f2f2f0}.ds-chip[aria-pressed=true]{border-color:#f2f2f0;background:#242424;color:#f2f2f0}"
    },
    {
      "name": "Lezione",
      "kind": "card",
      "refersTo": "card",
      "description": "Una lezione nel calendario: barra nella tinta del corso, ora e nome condensati.",
      "html": "<button class=\"ds-lezione\" style=\"--tinta:#1b8ac4\"><span class=\"ds-lezione-ora\">18:30</span><span class=\"ds-lezione-nome\">KARATE BAMBINI</span><span class=\"ds-lezione-conto\" data-fatto=\"true\">14/14</span></button>",
      "css": ".ds-lezione{display:flex;align-items:center;gap:12px;width:100%;padding:12px 14px;background:#1c1c1c;border:2px solid #333333;border-left:6px solid var(--tinta);border-radius:0;color:#f2f2f0;text-align:left;cursor:pointer;font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif}.ds-lezione:hover{border-color:#8c8c88;border-left-color:var(--tinta)}.ds-lezione-ora{font-size:20px;font-weight:700;min-width:62px;font-variant-numeric:tabular-nums}.ds-lezione-nome{flex-grow:1;font-size:19px;font-weight:700;letter-spacing:.03em}.ds-lezione-conto{font-size:20px;font-weight:700;color:#8c8c88;font-variant-numeric:tabular-nums}.ds-lezione-conto[data-fatto=true]{color:#16a54a}"
    },
    {
      "name": "Riga dell'appello",
      "kind": "custom",
      "refersTo": "riga-appello",
      "description": "Tre stati leggibili da lontano: bordo e segno colorati.",
      "html": "<div class=\"ds-appello\"><button class=\"ds-riga\" data-stato=\"presente\"><span class=\"ds-segno\">✓</span><span class=\"ds-nome\">Giulia Rossi</span></button><button class=\"ds-riga\" data-stato=\"assente\"><span class=\"ds-segno\">✕</span><span class=\"ds-nome\">Marco Bianchi</span></button><button class=\"ds-riga\"><span class=\"ds-segno\">·</span><span class=\"ds-nome\">Luca Verdi</span></button></div>",
      "css": ".ds-appello{display:flex;flex-direction:column;gap:8px}.ds-riga{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;padding:0 14px;background:#1c1c1c;border:2px solid #333333;border-radius:0;color:#f2f2f0;text-align:left;cursor:pointer}.ds-segno{font-family:'Saira Condensed','Helvetica Neue',Arial,sans-serif;font-size:22px;font-weight:700;width:26px;text-align:center;color:#5a5a56}.ds-nome{font-family:Barlow,'Helvetica Neue',Arial,sans-serif;font-size:17px;font-weight:500}.ds-riga[data-stato=presente]{border-color:#16a54a}.ds-riga[data-stato=presente] .ds-segno{color:#16a54a}.ds-riga[data-stato=assente]{border-color:#e4292a}.ds-riga[data-stato=assente] .ds-segno{color:#e4292a}.ds-riga[data-stato=assente] .ds-nome{color:#8c8c88;text-decoration:line-through}.ds-riga:focus-visible{outline:2px solid #f2f2f0;outline-offset:2px}"
    },
    {
