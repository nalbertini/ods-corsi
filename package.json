{
  "name": "ods-corsi",
  "private": true,
  "version": "0.26.1",
  "type": "module",
  "description": "Calendario dei corsi e registro delle presenze per Officine Dello Sport - Collegno",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dev:timer": "npm --prefix timer run dev",
    "build:timer": "npm --prefix timer run build -- --outDir ../dist/timer --emptyOutDir",
    "build:tutto": "npm run build && npm run build:timer",
    "prova:musica": "node scripts/prova-musica.mjs",
    "prova:coda": "node scripts/prova-coda.mjs",
    "prova:tablet": "node scripts/prova-tablet.mjs",
    "prova:segreteria": "node scripts/prova-segreteria.mjs",
    "prova:richieste": "node scripts/prova-richieste.mjs",
    "prova:firma": "node scripts/prova-firma.mjs",
    "prova:ricevuta": "node scripts/prova-ricevuta.mjs",
    "prova:prove": "node scripts/prova-prove.mjs",
    "prova:iscritti": "node scripts/prova-iscritti.mjs",
    "prova:listino": "node scripts/prova-listino.mjs",
    "prova:indirizzi": "node scripts/prova-indirizzi.mjs",
    "prova:informativa": "node scripts/prova-informativa.mjs",
    "prova:ore": "node scripts/prova-ore.mjs",
    "prova:anteprima": "node scripts/prova-anteprima.mjs",
    "prova:scaletta": "node scripts/prova-scaletta.mjs",
    "prova:sql": "bash scripts/prova-sql.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
